{
  "name": "haveask",
  "version": "1.0.0",
  "private": true,
  "description": "HaveAsk — AI Church Care Network. Private help requests, AI-suggested matches, human-approved care.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test server/tests/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@privy-io/node": "^0.41.0",
    "@privy-io/react-auth": "^3.52.0",
    "@stripe/stripe-js": "^10.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "viem": "^2.58.0",
    "vite": "^6.4.6"
  }
}
