# --- Required: sign-in (https://dashboard.privy.io → your app → Settings) ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Emails that become Pastor/Admin on first sign-in (comma-separated). Set this to your own email.
HAVEASK_ADMIN_EMAILS=

# --- Payments ---
# base (mainnet, real USDC) or base-sepolia (testnet). Default: base
HAVEASK_CHAIN=base
# Optional custom RPC (recommended in production, e.g. from Alchemy/QuickNode). Default: public Base RPC
BASE_RPC_URL=
# true if gas sponsorship is enabled for your app in the Privy dashboard
HAVEASK_SPONSOR_GAS=false

# --- Optional ---
ANTHROPIC_API_KEY=
# true = load synthetic demo data + demo controls (fast-forward clock, reset). Keep false for a real church.
HAVEASK_DEMO_DATA=false
# Where the SQLite database lives. On Railway, mount a volume at /app/data.
# HAVEASK_DATA_DIR=/app/data
